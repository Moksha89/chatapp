NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Database — PostgreSQL (production) or SQLite (development)
# Set DATABASE_URL for PostgreSQL; omit for SQLite file-based fallback
# DATABASE_URL=postgres://chatapp:chatapp_password@localhost:5432/chatapp
# SQLITE_DB_PATH=chatapp.db

# Database migrations — set DB_SYNCHRONIZE=false in production after initial setup
# When false, TypeORM runs migrations instead of auto-syncing schema
# DB_SYNCHRONIZE=false

# PostgreSQL connection pool (via TypeORM)
# DB_POOL_SIZE=20

# Redis (required for Socket.IO adapter and session management in cluster mode)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# OTP Provider: 'mock' for development (uses DEV_OTP), 'twilio' for production
OTP_PROVIDER=mock
DEV_OTP=123456

# Twilio (required when OTP_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
# TWILIO_PHONE_NUMBER=+1234567890

# TURN Server (optional, for WebRTC calls)
# TURN_URL=turn:your-turn-server:3478
# TURN_USERNAME=username
# TURN_PASSWORD=password
